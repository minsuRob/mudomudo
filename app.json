{
  "expo": {
    "name": "mudomudo",
    "slug": "mudomudo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mudomudo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mudomudo.app",
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.mudomudo.app"]
      }
    },
    "android": {
      "package": "com.mudomudo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-dev-client", { "launchMode": "most-recent" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "할 일에 작은 썸네일을 붙이기 위해 사진에 접근합니다.",
          "cameraPermission": "할 일에 작은 썸네일을 붙이기 위해 카메라에 접근합니다."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
